# ====================================================================
# SERVORA — Environment Configuration
# Copy this file to ".env" and fill in real values.
# The server works out of the box in DEV MODE with no keys filled in —
# OTPs print to the console/response and payments use a mock order —
# but nothing is "really" sent or charged until you add real keys below.
# ====================================================================

# ---- Core ----
PORT=4000
# Comma-separated list of allowed frontend origins for CORS. Leave empty if
# the frontend is served by this same server (the default setup) — only set
# this if you host the frontend on a separate domain from the API.
ALLOWED_ORIGINS=
NODE_ENV=development
# Any long random string — used to sign login sessions (JWTs)
JWT_SECRET=change-this-to-a-long-random-string

# ---- Database — REQUIRED before deploying for real ----
# Without MONGODB_URI, the app stores data in a local JSON file
# (server/data/db.json). That's fine for development, but most hosting
# platforms (Render, Railway, Heroku, etc.) wipe local disk on every
# restart or redeploy — every user, booking, and wallet balance would
# be lost. Set MONGODB_URI before you deploy.
#
# Free tier setup (MongoDB Atlas):
#  1. Sign up at https://www.mongodb.com/cloud/atlas/register
#  2. Create a free "M0" cluster (no credit card needed)
#  3. Database Access -> add a database user (username + password)
#  4. Network Access -> add IP address -> allow access from anywhere
#     (0.0.0.0/0) — simplest for getting started; tighten later if you want
#  5. Connect -> Drivers -> copy the connection string and paste below,
#     replacing <password> with your database user's password
MONGODB_URI=
MONGODB_DB_NAME=servora

# ---- Admin account (auto-created on first boot) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Razorpay (real payments) ----
# Get free TEST keys instantly at https://dashboard.razorpay.com/app/keys
# (no business documents needed for test mode). Live keys need KYC with
# Razorpay directly — that verification is Razorpay's, not this app's.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- SMS OTP — Option 1: 2Factor.in (recommended for India) ----
# Purpose-built for OTP delivery to Indian mobile numbers. Free trial,
# no phone number purchase, no DLT registration needed on your end
# (their OTP template is pre-approved). Sign up: https://2factor.in/v3/signup/
# Copy the API Key from your 2Factor dashboard.
TWO_FACTOR_API_KEY=

# ---- SMS OTP — Option 2: Twilio (works globally) ----
# Free trial account: https://www.twilio.com/try-twilio
# Note: buying an Indian (+91) number on Twilio requires regulatory
# approval that can take days; a non-Indian sender number may also get
# filtered by Indian carriers unless you complete DLT registration.
# Without either OTP provider configured, OTPs are logged to the server
# console + returned in the API response so you can still test the flow.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Google Sign-In (real OAuth) ----
# Create a free OAuth Client ID: https://console.cloud.google.com/apis/credentials
# Application type: "Web application". Add your domain (or
# http://localhost:4000 for local testing) under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
